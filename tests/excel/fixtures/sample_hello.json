 "rules": [
  {
   "name": "TrafficDensity",
   "formula": "=Population*RushHourMultiplier",
   "min": 0,
   "max": 4,
   "description": "Traffic cars ≈ 26 × this value"
  },
  {
   "name": "PoliceBudget",
   "formula": "=ROUND(BaseBudget*AlertLevel*PoliceResponse, 0)",
   "min": 0,
   "max": 14,
   "description": "Police cars allowed in a pursuit"
  },
  {
   "name": "MissionReward",
   "formula": "=BaseReward*DifficultyMultiplier",
   "min": 0,
   "max": 1000000,
   "description": "Base payout; each mission scales it"
  },
  {
   "name": "EscapeTime",
   "formula": "=6+AlertLevel*2.5",
   "min": 1,
   "max": 120,
   "description": "Seconds out of sight to lose one star"
  },
  {
   "name": "PedestrianCount",
   "formula": "=ROUND(34*PedestrianDensity, 0)",
   "min": 0,
   "max": 120,
   "description": "Pedestrians kept around the player"
  },
  {
   "name": "SearchRadius",
   "formula": "=60+AlertLevel*25",
   "min": 10,
   "max": 400,
   "description": "How far police search from the last sighting (m)"
  }
